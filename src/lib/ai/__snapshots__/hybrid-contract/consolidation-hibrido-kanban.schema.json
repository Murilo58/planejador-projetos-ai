{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "tap": {
          "type": "object",
          "properties": {
            "objective": {
              "type": "string",
              "description": "Objetivo do projeto. Usar exatamente \"Não identificado na especificação.\" quando a informação não existir no texto."
            },
            "scopeSummary": {
              "type": "string",
              "description": "Escopo resumido do projeto. Usar exatamente \"Não identificado na especificação.\" quando a informação não existir no texto."
            },
            "stakeholders": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Stakeholders identificados na especificação."
            },
            "successCriteria": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Critérios de sucesso identificados na especificação."
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Premissas identificadas."
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Restrições identificadas."
            }
          },
          "required": [
            "objective",
            "scopeSummary",
            "stakeholders",
            "successCriteria",
            "assumptions",
            "constraints"
          ],
          "additionalProperties": false
        },
        "eap": {
          "type": "object",
          "properties": {
            "deliverables": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "Código do entregável de alto nível: \"1\", \"2\", \"3\"… Único em toda a EAP."
                  },
                  "name": {
                    "type": "string",
                    "description": "Nome do entregável de alto nível (substantivo, não uma atividade/verbo de ação)."
                  },
                  "subDeliverables": {
                    "description": "Subentregáveis que, juntos, representam totalmente este entregável (regra dos 100%).",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Código do subentregável: código do entregável pai + \".\" + sequência (\"1.1\", \"1.2\", \"2.1\"…). Único em toda a EAP."
                        },
                        "name": {
                          "type": "string",
                          "description": "Nome do subentregável (substantivo, não uma atividade/verbo de ação)."
                        }
                      },
                      "required": [
                        "code",
                        "name"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "code",
                  "name"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "deliverables"
          ],
          "additionalProperties": false
        },
        "schedule": {
          "type": "object",
          "properties": {
            "phases": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Identificador da fase: \"F1\", \"F2\"… Único."
                  },
                  "name": {
                    "type": "string"
                  },
                  "eapCodes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Códigos da EAP produzidos (total ou parcialmente) nesta fase. Somente códigos existentes na EAP."
                  },
                  "milestones": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Identificador do marco: \"M1\", \"M2\"… Único em todo o cronograma."
                        },
                        "name": {
                          "type": "string",
                          "description": "Nome do marco, derivado da especificação."
                        },
                        "eapCodes": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Códigos da EAP cuja conclusão caracteriza este marco. Somente códigos existentes na EAP."
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "eapCodes"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Dependências relevantes entre fases, sem detalhamento operacional de tarefas."
                  }
                },
                "required": [
                  "id",
                  "name",
                  "eapCodes",
                  "milestones",
                  "dependencies"
                ],
                "additionalProperties": false
              },
              "description": "Fases e marcos, em sequência lógica. Usar datas apenas se identificadas na especificação; nunca inventar calendário."
            }
          },
          "required": [
            "phases"
          ],
          "additionalProperties": false
        },
        "columns": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Nome da coluna. Usar a estrutura padrão (Backlog, A Fazer, Em Andamento, Revisão, Concluído) salvo quando a especificação justificar claramente outro fluxo."
              },
              "wipLimit": {
                "type": "string",
                "description": "Limite de WIP sugerido para a coluna, como texto curto (ex.: \"3\"), ou uma breve explicação de por que não se aplica limite a esta coluna (ex.: \"Sem limite — coluna de entrada\")."
              },
              "wipJustification": {
                "type": "string",
                "description": "Justificativa do limite de WIP (ou de não haver limite). Nunca afirmar que é matematicamente ideal sem dados históricos; não assumir tamanho de equipe."
              }
            },
            "required": [
              "name",
              "wipLimit",
              "wipJustification"
            ],
            "additionalProperties": false
          }
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Identificador do item: \"KB-01\", \"KB-02\"… Único."
              },
              "eapCode": {
                "type": "string",
                "description": "Código da EAP ao qual este item está vinculado — preferir o nó mais específico (subentregável). Somente códigos existentes na EAP."
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "Descrição do item, derivada da especificação."
              },
              "type": {
                "type": "string",
                "description": "Classificação do item (ex.: funcionalidade, melhoria, tarefa técnica)."
              },
              "priority": {
                "type": "string",
                "enum": [
                  "alta",
                  "media",
                  "baixa"
                ]
              },
              "column": {
                "type": "string",
                "description": "Nome da coluna à qual o item pertence."
              },
              "dependency": {
                "description": "Dependência relevante, apenas se presente na especificação.",
                "type": "string"
              },
              "note": {
                "description": "Observação relevante, apenas se presente na especificação.",
                "type": "string"
              }
            },
            "required": [
              "id",
              "eapCode",
              "title",
              "description",
              "type",
              "priority",
              "column"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tap",
        "eap",
        "schedule",
        "columns",
        "items"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Observações curtas sobre o que foi ajustado, removido ou confirmado durante a consolidação."
    }
  },
  "required": [
    "data",
    "notes"
  ],
  "additionalProperties": false
}