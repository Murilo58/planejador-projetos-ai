# Copie este arquivo para .env.local e preencha com valores reais.
# Nunca comite .env* com valores reais (já ignorado em .gitignore).

# --- Banco de dados (Neon PostgreSQL) ---------------------------------------
# Connection string POOLADA (host termina em "-pooler"): usada pela aplicação
# em runtime (src/lib/db/prisma.ts). No painel do Neon: Connect > Pooled connection.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# Connection string DIRETA (sem "-pooler"): usada apenas pelo Prisma CLI para
# migrations (prisma migrate). No painel do Neon: Connect > Direct connection.
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/neondb?sslmode=require"

# --- Autenticação (Auth.js / NextAuth) --------------------------------------
# Segredo usado para assinar/criptografar o cookie de sessão (JWT).
# Gerar um valor aleatório com: npx auth secret
# (ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="defina-um-valor-aleatorio-de-pelo-menos-32-caracteres"

# --- IA (Gemini — Google GenAI) ---------------------------------------------
# Chave da API do Gemini (https://aistudio.google.com/apikey). Usada
# exclusivamente no servidor (src/lib/ai/client.ts) — nunca exposta ao
# navegador (RF-065).
GEMINI_API_KEY="defina-sua-chave-da-api-gemini"

# Opcional. Padrão: gemini-flash-latest (alias estável mantido pela Google).
# Defina aqui para fixar uma versão específica, se necessário.
# GEMINI_MODEL="gemini-flash-latest"

# --- Planejamento Híbrido (v1.1) ---------------------------------------------
# Feature flag (kill-switch) avaliada no servidor. Desligada por padrão: só
# "true" habilita as etapas do Híbrido (src/lib/hybrid/frameworks.ts). Scrum,
# Kanban e Cascata não dependem desta variável.
# HYBRID_PLANNING_ENABLED="false"
